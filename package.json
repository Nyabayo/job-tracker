{
  "name": "job-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source, self-hostable job application tracker",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test",
    "security": "bash scripts/security-check.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && node prisma/apply-sql.mts",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx lib/jobs/worker.ts",
    "security:quick": "bash scripts/security-check.sh --quick",
    "security:zap": "bash scripts/zap-baseline.sh",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run security",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "3.1150.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "1.5.0",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.1.0",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "rate-limiter-flexible": "11.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-security": "4.2.0",
    "jsdom": "29.1.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
