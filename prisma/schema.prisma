// Job Tracker data model (spec section 6).
//
// Conventions:
// - Every id is a random UUID v4 generated by Postgres (rule 2).
// - Every user-owned table has an indexed user_id and is protected by RLS
//   policies in prisma/rls.sql (A5). Never add a user-owned table without
//   adding it to rls.sql; tests/integration/rls-coverage.test.ts enforces this.
// - Tables and columns are snake_case in Postgres, camelCase in TypeScript.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum WorkType {
  REMOTE
  HYBRID
  ONSITE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  OTHER
}

enum SalaryPeriod {
  HOURLY
  MONTHLY
  YEARLY
}

enum DocumentType {
  CV
  COVER_LETTER
  ACADEMIC_CERT
  PROFESSIONAL_CERT
  TESTIMONIAL
  RECOMMENDATION
  OTHER
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum ContactRelationship {
  RECRUITER
  HIRING_MANAGER
  REFERRER
  INTERVIEWER
  OTHER
}

enum TaskKind {
  TASK
  FOLLOW_UP
  INTERVIEW
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  ASSESSMENT
}

enum TimelineEventType {
  CREATED
  STAGE_CHANGED
  FIELD_UPDATED
  DOCUMENT_ADDED
  CONTACT_ADDED
  TASK_COMPLETED
  NOTE_ADDED
  ARCHIVED
  RESTORED
}

enum EventSource {
  MANUAL
  EXTENSION
  EMAIL
  LINKEDIN
}

enum AuditEvent {
  SIGNUP
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGOUT
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  ACCESS_DENIED
  UPLOAD
  EXPORT
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_DELETED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
}

enum InboxStatus {
  PENDING
  APPROVED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Accounts (Auth.js standard tables plus our own fields)
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  emailVerified   DateTime? @map("email_verified") @db.Timestamptz(3)
  passwordHash    String?   @map("password_hash") // Argon2id, null for OAuth-only users
  name            String?
  image           String?
  totpSecret      String?   @map("totp_secret") // AES-256-GCM encrypted (A4, Sprint 3)
  totpEnabled     Boolean   @default(false) @map("totp_enabled")
  theme           Theme     @default(SYSTEM)
  timezone        String    @default("UTC")
  defaultCurrency String    @default("KES") @map("default_currency") @db.VarChar(3)
  emailReminders  Boolean   @default(false) @map("email_reminders")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  accounts       Account[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  recoveryCodes  RecoveryCode[]
  stages         Stage[]
  jobs           Job[]
  jobLinks       JobLink[]
  tags           Tag[]
  jobTags        JobTag[]
  notes          Note[]
  documents      Document[]
  jobDocuments   JobDocument[]
  contacts       Contact[]
  jobContacts    JobContact[]
  tasks          Task[]
  notifications  Notification[]
  timelineEvents TimelineEvent[]
  auditLogs      AuditLog[]
  inboxItems     InboxItem[]

  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Used for email verification (A3). `token` stores a SHA-256 hash, never the
// raw token that is emailed to the user.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// A3: single-use, 30 minute password reset tokens, stored hashed.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// A4 (Sprint 3): hashed 2FA recovery codes.
model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

// ---------------------------------------------------------------------------
// Board
// ---------------------------------------------------------------------------

model Stage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(60)
  order     Int
  color     String   @db.VarChar(7)
  isDefault Boolean  @default(false) @map("is_default")
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@unique([id, userId]) // lets children use composite FKs so rows can never point at another user's data
  @@index([userId, order])
  @@map("stages")
}

model Job {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  stageId            String          @map("stage_id") @db.Uuid
  positionInStage    Float           @default(0) @map("position_in_stage")
  title              String          @db.VarChar(200)
  companyName        String          @map("company_name") @db.VarChar(200)
  companyUrl         String?         @map("company_url") @db.VarChar(2048)
  jobPostUrl         String?         @map("job_post_url") @db.VarChar(2048)
  jobBoardName       String?         @map("job_board_name") @db.VarChar(100)
  jobBoardUrl        String?         @map("job_board_url") @db.VarChar(2048)
  location           String?         @db.VarChar(200)
  country            String?         @db.VarChar(2)
  workType           WorkType?       @map("work_type")
  employmentType     EmploymentType? @map("employment_type")
  salaryMin          Decimal?        @map("salary_min") @db.Decimal(14, 2)
  salaryMax          Decimal?        @map("salary_max") @db.Decimal(14, 2)
  salaryCurrency     String?         @map("salary_currency") @db.VarChar(3)
  salaryPeriod       SalaryPeriod?   @map("salary_period")
  excitement         Int?            @db.SmallInt
  dateSaved          DateTime        @default(now()) @map("date_saved") @db.Timestamptz(3)
  dateApplied        DateTime?       @map("date_applied") @db.Timestamptz(3)
  deadline           DateTime?       @db.Timestamptz(3)
  descriptionHtml    String?         @map("description_html")
  descriptionSavedAt DateTime?       @map("description_saved_at") @db.Timestamptz(3)
  archivedAt         DateTime?       @map("archived_at") @db.Timestamptz(3)
  lastActivityAt     DateTime        @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage          Stage           @relation(fields: [stageId, userId], references: [id, userId], onDelete: Restrict)
  links          JobLink[]
  tags           JobTag[]
  notes          Note[]
  documents      JobDocument[]
  contacts       JobContact[]
  tasks          Task[]
  timelineEvents TimelineEvent[]
  inboxItems     InboxItem[]

  @@unique([id, userId]) // lets children use composite FKs so rows can never point at another user's data
  @@index([userId])
  @@index([userId, stageId, positionInStage])
  @@index([userId, archivedAt])
  @@map("jobs")
}

model JobLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  label     String   @db.VarChar(100)
  url       String   @db.VarChar(2048)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
  @@map("job_links")
}

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs JobTag[]

  @@unique([id, userId]) // lets children use composite FKs so rows can never point at another user's data
  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model JobTag {
  jobId     String   @map("job_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId, userId], references: [id, userId], onDelete: Cascade)

  @@id([jobId, tagId])
  @@index([userId])
  @@index([tagId])
  @@map("job_tags")
}

model Note {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  contentHtml String   @map("content_html")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
  @@map("notes")
}

// ---------------------------------------------------------------------------
// Documents, contacts, tasks
// ---------------------------------------------------------------------------

model Document {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  type         DocumentType
  originalName String       @map("original_name") @db.VarChar(255)
  storageKey   String       @unique @map("storage_key")
  mimeType     String       @map("mime_type") @db.VarChar(100)
  sizeBytes    Int          @map("size_bytes")
  sha256       String       @db.VarChar(64)
  versionLabel String?      @map("version_label") @db.VarChar(100)
  scanStatus   ScanStatus   @default(PENDING) @map("scan_status")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs JobDocument[]

  @@unique([id, userId]) // lets children use composite FKs so rows can never point at another user's data
  @@index([userId])
  @@map("documents")
}

// Many-to-many so the v2 document library can reuse files without a migration.
model JobDocument {
  jobId      String   @map("job_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job      Job      @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)
  document Document @relation(fields: [documentId, userId], references: [id, userId], onDelete: Cascade)

  @@id([jobId, documentId])
  @@index([userId])
  @@index([documentId])
  @@map("job_documents")
}

model Contact {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String    @db.VarChar(200)
  role            String?   @db.VarChar(200)
  company         String?   @db.VarChar(200)
  email           String?   @db.VarChar(320)
  phone           String?   @db.VarChar(50)
  linkedinUrl     String?   @map("linkedin_url") @db.VarChar(2048)
  notes           String?
  lastContactedAt DateTime? @map("last_contacted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs JobContact[]

  @@unique([id, userId]) // lets children use composite FKs so rows can never point at another user's data
  @@index([userId])
  @@map("contacts")
}

model JobContact {
  jobId        String              @map("job_id") @db.Uuid
  contactId    String              @map("contact_id") @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  relationship ContactRelationship @default(OTHER)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)
  contact Contact @relation(fields: [contactId, userId], references: [id, userId], onDelete: Cascade)

  @@id([jobId, contactId])
  @@index([userId])
  @@index([contactId])
  @@map("job_contacts")
}

model Task {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  jobId         String?        @map("job_id") @db.Uuid
  title         String         @db.VarChar(200)
  dueAt         DateTime?      @map("due_at") @db.Timestamptz(3)
  remindAt      DateTime?      @map("remind_at") @db.Timestamptz(3)
  completedAt   DateTime?      @map("completed_at") @db.Timestamptz(3)
  kind          TaskKind       @default(TASK)
  interviewType InterviewType? @map("interview_type")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([jobId])
  @@index([remindAt])
  @@map("tasks")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String    @db.VarChar(50)
  title     String    @db.VarChar(200)
  body      String?
  link      String?   @db.VarChar(2048)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model TimelineEvent {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  jobId     String            @map("job_id") @db.Uuid
  type      TimelineEventType
  payload   Json              @default("{}")
  source    EventSource       @default(MANUAL)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId])
  @@index([jobId, createdAt(sort: Desc)])
  @@map("timeline_events")
}

// Security audit trail. Never stores document contents. When a user is purged
// (A7) their audit rows are kept anonymised (user_id set to null).
model AuditLog {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?    @map("user_id") @db.Uuid
  event     AuditEvent
  ip        String?    @db.VarChar(64) // truncated: /24 for IPv4, /48 for IPv6
  userAgent String?    @map("user_agent") @db.VarChar(512)
  detail    Json?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Future-ready (v2): no UI yet.
// ---------------------------------------------------------------------------

model InboxItem {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  jobId          String?     @map("job_id") @db.Uuid
  source         EventSource
  evidence       String?
  proposedChange Json        @default("{}") @map("proposed_change")
  status         InboxStatus @default(PENDING)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("inbox_items")
}
