# Job Tracker configuration. Copy to .env, or run ./scripts/selfhost.sh which
# fills every secret below with a fresh random value. Never commit .env.

# Public address of the app. Use https:// in production (enables Secure
# cookies, HSTS and upgrade-insecure-requests).
APP_URL=http://localhost:3000

# 64 hex characters: openssl rand -hex 32
AUTH_SECRET=change-me

# ---- Database --------------------------------------------------------------
# Docker Compose builds the URLs from these passwords. Three roles: owner
# (migrations only), app (row-level security) and auth (login only).
POSTGRES_SUPERUSER_PASSWORD=change-me
JT_OWNER_PASSWORD=change-me
JT_APP_PASSWORD=change-me
JT_AUTH_PASSWORD=change-me
# Outside Docker, set the URLs directly:
# DATABASE_URL_OWNER=postgresql://jt_owner:PASSWORD@localhost:5432/jobtracker
# DATABASE_URL=postgresql://jt_app:PASSWORD@localhost:5432/jobtracker
# DATABASE_URL_AUTH=postgresql://jt_auth:PASSWORD@localhost:5432/jobtracker

# ---- Email (Mailpit catches everything locally) ----------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Job Tracker <no-reply@jobtracker.local>

# ---- File storage (any S3-compatible service; private bucket) --------------
S3_ENDPOINT=http://storage:8333
S3_REGION=us-east-1
S3_BUCKET=jobtracker
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
MAX_UPLOAD_MB=10

# ---- 2FA secret encryption (64 hex characters) ------------------------------
TOTP_ENCRYPTION_KEY=change-me

# Set to true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false
